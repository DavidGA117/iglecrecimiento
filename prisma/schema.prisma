generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model usuarios {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  password  String
  nombre    String
  rol       String   @default("admin")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("usuarios")
}

model personas {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String
  telefono       String?
  total_objetivo Decimal?  @default(0) @map("total_objetivo") @db.Decimal(10, 2)
  total_abonado  Decimal?  @default(0) @map("total_abonado") @db.Decimal(10, 2)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  abonos         abonos[]

  @@map("personas")
}

model abonos {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  persona_id     String?   @map("persona_id") @db.Uuid
  cantidad       Decimal   @db.Decimal(10, 2)
  tipo           String    @default("seminario") @map("tipo") @db.VarChar(20)
  fecha          DateTime? @default(now()) @db.Timestamp(6)
  registrado_por String?   @map("registrado_por")
  personas       personas? @relation(fields: [persona_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("abonos")
}